      "rdfs:label": {
        "@value": "DerivedFrom",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Link to a parent file by its FHR-family checksum (specs/004-shared-core-schema FR-003). Provisional until the relationship vocabulary is decided (FAIR-bioHeaders-Specification#54).",
        "@language": "en"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
