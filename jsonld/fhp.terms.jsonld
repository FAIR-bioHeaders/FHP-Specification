  "@graph": [
    {
      "@id": "https://w3id.org/fair-bioheaders/terms",
      "@type": "owl:Ontology",
      "rdfs:label": {
        "@value": "FAIR-bioHeaders vocabulary (draft FHP additions)",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Draft FHP vocabulary additions, generated from fhp_linkml.yml. The shared FAIR-bioHeaders terms are owned by jsonld/terms.ttl and are reused, not redefined; they are pinned to FAIR-bioHeaders-Specification v0.4.0 at commit 43f9067d0ce21e9ae63fd9eee64f9c2af0b73ff4 (https://raw.githubusercontent.com/FAIR-bioHeaders/FAIR-bioHeaders-Specification/43f9067d0ce21e9ae63fd9eee64f9c2af0b73ff4/jsonld/terms.ttl). Runtime support is coordinated with FAIR-bioHeaders-Tools#58; publication with FAIR-bioHeaders-Specification#107.",
        "@language": "en"
      },
      "dcterms:license": {
        "@id": "https://www.mozilla.org/en-US/MPL/2.0/"
      },
      "rdfs:seeAlso": {
        "@id": "https://github.com/FAIR-bioHeaders/FHP-Specification/blob/main/docs/FHP.md"
      }
    },
    {
      "@id": "fhr:Completeness",
      "@type": "rdfs:Class",
      "rdfs:label": {
        "@value": "Completeness",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "BUSCO completeness as counts, with the lineage dataset whose name gives its version (for example primates_odb10)",
        "@language": "en"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
