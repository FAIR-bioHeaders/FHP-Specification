#   locator: https://raw.githubusercontent.com/FAIR-bioHeaders/FAIR-bioHeaders-Specification/84c2f90ab0e97c81d8afbf33eafe80ebade7a009/jsonld/terms.ttl
#   release: https://github.com/FAIR-bioHeaders/FAIR-bioHeaders-Specification/releases/tag/v0.4.0
# Reused published vocabulary; owned by jsonld/terms.ttl, never redefined here:
#   fhr:Agent
#   fhr:accessionID
#   fhr:checksum
#   fhr:commandLineOption
#   fhr:metadataAuthor
#   fhr:nameType
#   fhr:relatedLink
#   fhr:schemaVersion
#   fhr:seqcol_id
#   fhr:voucherSpecimen
# Inherited core terms; owned by schemas/core-v0.4.yaml, defined here because the published vocabulary does not yet include them:
#   fhr:DerivedFrom
#   fhr:derivedFrom
#   fhr:headerType
#   fhr:relationship
# Inherited family terms; owned by schemas/shared.yaml:
