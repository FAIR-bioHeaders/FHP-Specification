#   fhr:predictionProtocol
#   fhr:predictionSoftware
#   fhr:sequenceStats
#   fhr:source
#   fhr:sourceType
#   fhr:totalResidues
# Term IRIs never change and are never reused with another meaning.

@prefix fhr:     <https://w3id.org/fair-bioheaders/terms#> .
@prefix sdo:     <http://schema.org/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://w3id.org/fair-bioheaders/terms> a owl:Ontology ;
    rdfs:label "FAIR-bioHeaders vocabulary (draft FHP additions)"@en ;
    rdfs:comment "Draft FHP vocabulary for released FHP 1.0, generated from fhp_linkml.yml. The published FAIR-bioHeaders terms are owned by jsonld/terms.ttl and are reused, not redefined; they are pinned to FAIR-bioHeaders-Specification v0.4.0 at commit 84c2f90ab0e97c81d8afbf33eafe80ebade7a009 (https://raw.githubusercontent.com/FAIR-bioHeaders/FAIR-bioHeaders-Specification/84c2f90ab0e97c81d8afbf33eafe80ebade7a009/jsonld/terms.ttl). Inherited core terms are owned by schemas/core-v0.4.yaml and family terms by schemas/shared.yaml; only terms unique to FHP are FHP-owned. Runtime support is coordinated with FAIR-bioHeaders-Tools#58; publication with FAIR-bioHeaders-Specification#107."@en ;
    dcterms:license <https://www.mozilla.org/en-US/MPL/2.0/> ;
    rdfs:seeAlso <https://github.com/FAIR-bioHeaders/FHP-Specification/blob/main/docs/FHP.md> .

fhr:Completeness a rdfs:Class ;
    rdfs:label "Completeness"@en ;
    rdfs:comment "BUSCO completeness as counts, with the lineage dataset whose name gives its version (for example primates_odb10)"@en ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .

fhr:DerivedFrom a rdfs:Class ;
    rdfs:label "DerivedFrom"@en ;
    rdfs:comment "Link to a parent file by its FHR-family checksum (specs/004-shared-core-schema FR-003). Provisional until the relationship vocabulary is decided (FAIR-bioHeaders-Specification#54)."@en ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .

fhr:SequenceStats a rdfs:Class ;
    rdfs:label "SequenceStats"@en ;
    rdfs:comment "Counts describing a protein set"@en ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .

fhr:Source a rdfs:Class ;
    rdfs:label "Source"@en ;
    rdfs:comment "A source of sequences that is not a FAIR-bioHeaders file: a database release, set, annotation run or other contribution"@en ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .

fhr:assemblyAccession a rdf:Property ;
    rdfs:label "assemblyAccession"@en ;
    rdfs:comment "Genome assembly accession that the source states for this set; an assertion by the source, not a checksum link"@en ;
    sdo:domainIncludes fhr:Source ;
    sdo:rangeIncludes sdo:Text ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .

fhr:buscoVersion a rdf:Property ;
    rdfs:label "buscoVersion"@en ;
    rdfs:comment "Version of BUSCO"@en ;
    sdo:domainIncludes fhr:Completeness ;
    sdo:rangeIncludes sdo:Text ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .

fhr:completeDuplicated a rdf:Property ;
    rdfs:label "completeDuplicated"@en ;
    rdfs:comment "Complete duplicated BUSCOs (D)"@en ;
    sdo:domainIncludes fhr:Completeness ;
    sdo:rangeIncludes sdo:Integer ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .

fhr:completeness a rdf:Property ;
    rdfs:label "completeness"@en ;
    rdfs:comment "BUSCO completeness of the protein set, as counts"@en ;
    sdo:domainIncludes sdo:Dataset ;
    sdo:rangeIncludes fhr:Completeness ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .

fhr:completeSingle a rdf:Property ;
    rdfs:label "completeSingle"@en ;
    rdfs:comment "Complete single-copy BUSCOs (S)"@en ;
    sdo:domainIncludes fhr:Completeness ;
    sdo:rangeIncludes sdo:Integer ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .

fhr:derivedFrom a rdf:Property ;
    rdfs:label "derivedFrom"@en ;
    rdfs:comment "Parent files this file was derived from, identified by their FHR-family checksum. Header types opt in by listing this slot; FHR schemaVersion 1 does not include it."@en ;
    sdo:domainIncludes sdo:Dataset ;
    sdo:rangeIncludes fhr:DerivedFrom ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .

fhr:fragmented a rdf:Property ;
    rdfs:label "fragmented"@en ;
    rdfs:comment "Fragmented BUSCOs (F)"@en ;
    sdo:domainIncludes fhr:Completeness ;
    sdo:rangeIncludes sdo:Integer ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .

fhr:geneCount a rdf:Property ;
    rdfs:label "geneCount"@en ;
    rdfs:comment "Number of genes the sequences represent"@en ;
    sdo:domainIncludes fhr:SequenceStats ;
    sdo:rangeIncludes sdo:Integer ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .

fhr:geneticCode a rdf:Property ;
    rdfs:label "geneticCode"@en ;
    rdfs:comment "NCBI translation table ID used to translate the sequences (1-6, 9-16 or 21-33); omitted when unknown or when the file mixes tables"@en ;
    sdo:domainIncludes sdo:Dataset ;
    sdo:rangeIncludes sdo:Integer ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .

fhr:headerType a rdf:Property ;
    rdfs:label "headerType"@en ;
    rdfs:comment "FAIR-bioHeaders type of the parent file"@en ;
    sdo:domainIncludes fhr:DerivedFrom ;
    sdo:rangeIncludes sdo:Text ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .

fhr:isoformPolicy a rdf:Property ;
    rdfs:label "isoformPolicy"@en ;
    rdfs:comment "Which protein isoforms of each gene the set contains"@en ;
    sdo:domainIncludes sdo:Dataset ;
    sdo:rangeIncludes sdo:Text ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .

fhr:lineageDataset a rdf:Property ;
    rdfs:label "lineageDataset"@en ;
    rdfs:comment "BUSCO lineage dataset, including its version suffix"@en ;
    sdo:domainIncludes fhr:Completeness ;
    sdo:rangeIncludes sdo:Text ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .

fhr:missing a rdf:Property ;
    rdfs:label "missing"@en ;
    rdfs:comment "Missing BUSCOs (M)"@en ;
    sdo:domainIncludes fhr:Completeness ;
    sdo:rangeIncludes sdo:Integer ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .

fhr:mode a rdf:Property ;
    rdfs:label "mode"@en ;
    rdfs:comment "BUSCO mode"@en ;
    sdo:domainIncludes fhr:Completeness ;
    sdo:rangeIncludes sdo:Text ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .

fhr:predictionProtocol a rdf:Property ;
    rdfs:label "predictionProtocol"@en ;
    rdfs:comment "Prediction or annotation protocol or workflow reference URI"@en ;
    sdo:domainIncludes sdo:Dataset ;
    sdo:rangeIncludes sdo:URL ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .

fhr:predictionSoftware a rdf:Property ;
    rdfs:label "predictionSoftware"@en ;
    rdfs:comment "Software that produced the gene models or translations"@en ;
    sdo:domainIncludes sdo:Dataset ;
    sdo:rangeIncludes sdo:SoftwareApplication ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .

fhr:relationship a rdf:Property ;
    rdfs:label "relationship"@en ;
    rdfs:comment "How this file relates to the parent. Provisional vocabulary: a PROV-O or Relation Ontology mapping is pending a maintainer decision (FAIR-bioHeaders-Specification#54)."@en ;
    sdo:domainIncludes fhr:DerivedFrom ;
    sdo:rangeIncludes sdo:Text ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .

fhr:release a rdf:Property ;
    rdfs:label "release"@en ;
    rdfs:comment "Release or annotation run of the source, as the source names it"@en ;
    sdo:domainIncludes fhr:Source ;
    sdo:rangeIncludes sdo:Text ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .

fhr:sequenceCount a rdf:Property ;
    rdfs:label "sequenceCount"@en ;
    rdfs:comment "Number of protein sequences in the file"@en ;
    sdo:domainIncludes fhr:SequenceStats, fhr:Source ;
    sdo:rangeIncludes sdo:Integer ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .

fhr:sequenceStats a rdf:Property ;
    rdfs:label "sequenceStats"@en ;
    rdfs:comment "Counts describing the protein set, as asserted by the producer"@en ;
    sdo:domainIncludes sdo:Dataset ;
    sdo:rangeIncludes fhr:SequenceStats ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .

fhr:setIdentifier a rdf:Property ;
    rdfs:label "setIdentifier"@en ;
    rdfs:comment "Identifier of the set taken from the source, for example a UniProt proteome ID"@en ;
    sdo:domainIncludes fhr:Source ;
    sdo:rangeIncludes sdo:Text ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .

fhr:source a rdf:Property ;
    rdfs:label "source"@en ;
    rdfs:comment "Sources of the sequences that are not FAIR-bioHeaders files, as asserted by the producer; never verified by checksum"@en ;
    sdo:domainIncludes sdo:Dataset ;
    sdo:rangeIncludes fhr:Source ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .

fhr:sourceType a rdf:Property ;
    rdfs:label "sourceType"@en ;
    rdfs:comment "Where the sequences came from: predicted (a gene-prediction or annotation run), database (a published database release, set or annotation run) or mixed (more than one origin). Not a review status."@en ;
    sdo:domainIncludes sdo:Dataset ;
    sdo:rangeIncludes sdo:Text ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .

fhr:total a rdf:Property ;
    rdfs:label "total"@en ;
    rdfs:comment "Number of BUSCO groups searched (n)"@en ;
    sdo:domainIncludes fhr:Completeness ;
    sdo:rangeIncludes sdo:Integer ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .

fhr:totalResidues a rdf:Property ;
    rdfs:label "totalResidues"@en ;
    rdfs:comment "Total number of residues in the file"@en ;
    sdo:domainIncludes fhr:SequenceStats ;
    sdo:rangeIncludes sdo:Integer ;
    rdfs:isDefinedBy <https://w3id.org/fair-bioheaders/terms> .
